# Copy to .env before `docker compose up`:  cp .env.example .env
# These are development placeholders, not real secrets.

POSTGRES_USER=hirose
POSTGRES_PASSWORD=change-me
POSTGRES_DB=maintenance

# Must be at least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# Set to true only when served over HTTPS.
COOKIE_SECURE=false

# Host port where the app is published.
WEB_PORT=8080
